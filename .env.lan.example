# =====================================================================
# SISTEM PERPUSTAKAAN SEKOLAH - KONFIGURASI SERVER LAN (HTTP)
# =====================================================================

# Aplikasi
APP_NAME="Sistem Informasi Perpustakaan"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost

# Jaringan & Port Server
# HTTP_PORT adalah port yang dibuka Caddy ke jaringan LAN (default: 80)
HTTP_PORT=80
HTTP_BIND_IP=0.0.0.0

# Database (Hanya dapat diakses internal oleh container lain, tidak diekspos ke LAN)
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=

# Session & Keamanan Cookie (SESSION_SECURE_COOKIE=false karena akses via HTTP LAN)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Cache, Antrian, & Storage
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Nuxt Frontend SSR
# Akan diperbarui otomatis oleh launcher sesuai IP LAN PC Server
NUXT_PUBLIC_API_BASE_URL=http://localhost/api
WWWUSER=1000
