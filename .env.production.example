# Production template only. Copy to .env.production on the deployment host.
# Fill all blank values and replace host/path placeholders before running Compose.
# Run with: docker compose --env-file .env.production -f compose.production.yaml up -d
# Keep .env.production, database passwords, APP_KEY, and TLS private keys out of Git.
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://REPLACE_WITH_LAN_HOSTNAME
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=library_prod
DB_USERNAME=library_app
DB_PASSWORD=
POSTGRES_ADMIN_USER=library_db_admin
POSTGRES_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Keep the browser UI and API on the same HTTPS origin through Caddy.
NUXT_PUBLIC_API_BASE_URL=https://REPLACE_WITH_LAN_HOSTNAME/api
PUBLIC_HOST=REPLACE_WITH_LAN_HOSTNAME
HTTPS_BIND_IP=REPLACE_WITH_SERVER_LAN_IPV4
HTTPS_PORT=443
TLS_CERT_FILE=C:/secure/path/library-fullchain.pem
TLS_KEY_FILE=C:/secure/path/library-private-key.pem

# Supply immutable, production-built images from the deployment image registry.
LARAVEL_IMAGE=
NUXT_IMAGE=
